[{"id":226182,"collectionId":"muslim","categoryId":"muslim:1","number":1,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 1","gradeBn":"","gradeEn":""},{"id":226183,"collectionId":"muslim","categoryId":"muslim:1","number":2,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 2","gradeBn":"","gradeEn":""},{"id":226184,"collectionId":"muslim","categoryId":"muslim:1","number":3,"textAr":"وَحَدَّثَنِي زُهَيْرُ بْنُ حَرْبٍ، حَدَّثَنَا إِسْمَاعِيلُ، - يَعْنِي ابْنَ عُلَيَّةَ - عَنْ عَبْدِ الْعَزِيزِ بْنِ صُهَيْبٍ، عَنْ أَنَسِ بْنِ مَالِكٍ، أَنَّهُ قَالَ إِنَّهُ لَيَمْنَعُنِي أَنْ أُحَدِّثَكُمْ حَدِيثًا كَثِيرًا أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ \"‏ مَنْ تَعَمَّدَ عَلَىَّ كَذِبًا فَلْيَتَبَوَّأْ مَقْعَدَهُ مِنَ النَّارِ ‏\"‏ ‏.‏","textBn":"","textEn":"Zuhayr bin Harb narrated to me, Ismā’īl, rather, Ibn Ulayyah narrated to us, on authority of Abd il-Azīz ibn Suhayb, on authority of Anas bin Mālik, that he said:‘Indeed what prevents me from relating to you a great number of Ḥadīth is that the Messenger of Allah, peace and blessings of Allah upon him, said: ‘Whoever intends to lie upon me, then let him take his seat in the Fire.’","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 3","gradeBn":"","gradeEn":""},{"id":226185,"collectionId":"muslim","categoryId":"muslim:1","number":4,"textAr":"وَحَدَّثَنَا مُحَمَّدُ بْنُ عُبَيْدٍ الْغُبَرِيُّ، حَدَّثَنَا أَبُو عَوَانَةَ، عَنْ أَبِي حَصِينٍ، عَنْ أَبِي صَالِحٍ، عَنْ أَبِي هُرَيْرَةَ، قَالَ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ مَنْ كَذَبَ عَلَىَّ مُتَعَمِّدًا فَلْيَتَبَوَّأْ مَقْعَدَهُ مِنَ النَّارِ ‏\"‏ ‏.‏","textBn":"","textEn":"Muhammad bin Ubayd il-Ghubarī narrated to us, Abū Awānah narrated to us, on authority of Abī Hasīn, on authority of Abī Sālih, on authority of Abū Hurayrah, he said, the Messenger of Allah, peace and blessings of Allah upon him, said:‘Whoever lies upon me intentionally, then let him take his seat in the Fire’","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 4","gradeBn":"","gradeEn":""},{"id":226186,"collectionId":"muslim","categoryId":"muslim:1","number":5,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 5","gradeBn":"","gradeEn":""},{"id":226187,"collectionId":"muslim","categoryId":"muslim:1","number":6,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 6","gradeBn":"","gradeEn":""},{"id":226188,"collectionId":"muslim","categoryId":"muslim:1","number":7,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 7","gradeBn":"","gradeEn":""},{"id":226189,"collectionId":"muslim","categoryId":"muslim:1","number":8,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 8","gradeBn":"","gradeEn":""},{"id":226190,"collectionId":"muslim","categoryId":"muslim:1","number":9,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 9","gradeBn":"","gradeEn":""},{"id":226191,"collectionId":"muslim","categoryId":"muslim:1","number":10,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 10","gradeBn":"","gradeEn":""},{"id":226192,"collectionId":"muslim","categoryId":"muslim:1","number":11,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 11","gradeBn":"","gradeEn":""},{"id":226193,"collectionId":"muslim","categoryId":"muslim:1","number":12,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 12","gradeBn":"","gradeEn":""},{"id":226194,"collectionId":"muslim","categoryId":"muslim:1","number":13,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 13","gradeBn":"","gradeEn":""},{"id":226195,"collectionId":"muslim","categoryId":"muslim:1","number":14,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 14","gradeBn":"","gradeEn":""},{"id":226196,"collectionId":"muslim","categoryId":"muslim:1","number":15,"textAr":"وَحَدَّثَنِي مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ، وَزُهَيْرُ بْنُ حَرْبٍ، قَالاَ حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يَزِيدَ، قَالَ حَدَّثَنِي سَعِيدُ بْنُ أَبِي أَيُّوبَ، قَالَ حَدَّثَنِي أَبُو هَانِئٍ، عَنْ أَبِي عُثْمَانَ، مُسْلِمِ بْنِ يَسَارٍ عَنْ أَبِي هُرَيْرَةَ، عَنْ رَسُولِ اللَّهِ صلى الله عليه وسلم أَنَّهُ قَالَ ‏ \"‏ سَيَكُونُ فِي آخِرِ أُمَّتِي أُنَاسٌ يُحَدِّثُونَكُمْ مَا لَمْ تَسْمَعُوا أَنْتُمْ وَلاَ آبَاؤُكُمْ فَإِيَّاكُمْ وَإِيَّاهُمْ ‏\"‏ ‏.‏,وَحَدَّثَنِي حَرْمَلَةُ بْنُ يَحْيَى بْنِ عَبْدِ اللَّهِ بْنِ حَرْمَلَةَ بْنِ عِمْرَانَ التُّجِيبِيُّ، قَالَ حَدَّثَنَا ابْنُ وَهْبٍ، قَالَ حَدَّثَنِي أَبُو شُرَيْحٍ، أَنَّهُ سَمِعَ شَرَاحِيلَ بْنَ يَزِيدَ، يَقُولُ أَخْبَرَنِي مُسْلِمُ بْنُ يَسَارٍ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ، يَقُولُ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ يَكُونُ فِي آخِرِ الزَّمَانِ دَجَّالُونَ كَذَّابُونَ يَأْتُونَكُمْ مِنَ الأَحَادِيثِ بِمَا لَمْ تَسْمَعُوا أَنْتُمْ وَلاَ آبَاؤُكُمْ فَإِيَّاكُمْ وَإِيَّاهُمْ لاَ يُضِلُّونَكُمْ وَلاَ يَفْتِنُونَكُمْ ‏\"‏ ‏.‏","textBn":"","textEn":"Muhammad bin Abd Allah bin Numayr and Zuhayr bin Harb narrated to me, they said Abd Allah bin Yazīd narrated to us, he said Sa’īd bin Abī Ayyūb narrated to me, he said Abū Hāni’ narrated to me, on authority of Uthmān Muslim bin Yasār, on authority of Abī Hurayrah, on authority of the Messenger of Allah, peace and blessings of Allah upon him, he said:‘There will be in the last of my nation a people narrating to you what you nor your fathers heard, so beware of them’. ,Harmalah bin Yahyā bin Abd Allah bin Harmalah bin Imrān at-Tujībī narrated to me, he said Ibn Wahb narrated to us, he said Abū Shurayh narrated to me that he heard Sharāhīl bin Yazīd saying ‘Muslim bin Yasār informed me that he heard Abā Hurayrah saying, the Messenger of Allah, peace and blessings of Allah upon him, said:‘There will be in the end of time charlatan liars coming to you with narrations that you nor your fathers heard, so beware of them lest they misguide you and cause you tribulations’.’","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 15","gradeBn":"","gradeEn":""},{"id":226197,"collectionId":"muslim","categoryId":"muslim:1","number":16,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 16","gradeBn":"","gradeEn":""},{"id":226198,"collectionId":"muslim","categoryId":"muslim:1","number":17,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 17","gradeBn":"","gradeEn":""},{"id":226199,"collectionId":"muslim","categoryId":"muslim:1","number":18,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 18","gradeBn":"","gradeEn":""},{"id":226200,"collectionId":"muslim","categoryId":"muslim:1","number":19,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 19","gradeBn":"","gradeEn":""},{"id":226201,"collectionId":"muslim","categoryId":"muslim:1","number":20,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 20","gradeBn":"","gradeEn":""},{"id":226202,"collectionId":"muslim","categoryId":"muslim:1","number":21,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 21","gradeBn":"","gradeEn":""},{"id":226203,"collectionId":"muslim","categoryId":"muslim:1","number":22,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 22","gradeBn":"","gradeEn":""},{"id":226204,"collectionId":"muslim","categoryId":"muslim:1","number":23,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","reference":"Sahih Muslim 23","gradeBn":"","gradeEn":""},{"id":226205,"collectionId":"muslim","categoryId":"muslim:1","number":24,"textAr":"","textBn":"","textEn":"","narratorBn":"","narratorEn":"","